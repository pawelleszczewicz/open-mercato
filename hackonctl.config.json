          "id": "docs-root",
          "patterns": [
            "README.md",
            "CONTRIBUTING.md",
            ".ai/specs/**",
            "docs/**"
          ],
          "lane": "docs",
          "riskZone": "low",
          "primaryAreaOwners": [
