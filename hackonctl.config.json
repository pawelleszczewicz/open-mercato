{
  "version": 1,
  "runtime": {
    "stateDir": ".state",
    "workspaceDir": ".workspace"
  },
  "policy": {
    "maxActiveExperimental": 1,
    "requireDifferentiationNoteOnOverride": true,
    "laneGuardrails": {
      "docs": {
        "maxChangedFiles": 20,
        "maxDiffLines": 20000,
        "forbiddenPathPatterns": []
      },
      "tests": {
        "maxChangedFiles": 30,
        "maxDiffLines": 1500,
        "forbiddenPathPatterns": []
      },
      "simple_bugs": {
        "maxChangedFiles": 35,
        "maxDiffLines": 20000,
        "forbiddenPathPatterns": []
      },
      "experimental": {
        "maxChangedFiles": 80,
        "maxDiffLines": 5000,
        "forbiddenPathPatterns": []
      }
    }
  },
  "github": {
    "provider": "github_mcp_then_pat_api",
    "mcpUrl": "https://api.githubcopilot.com/mcp/",
    "mcpTokenEnvVar": "GITHUB_PERSONAL_ACCESS_TOKEN"
  },
  "codex": {
    "binary": "codex",
    "implementer": {
      "model": "gpt-5.4",
      "sandboxMode": "danger-full-access",
      "timeoutMs": 2700000,
      "maxAutomaticRetries": 1,
      "failFastOnApprovalSensitive": true
    },
    "testImplementer": {
      "model": "gpt-5.4",
      "sandboxMode": "danger-full-access",
      "timeoutMs": 3600000,
      "maxAutomaticRetries": 1,
      "failFastOnApprovalSensitive": true
    },
    "reviewer": {
      "model": "gpt-5.4",
      "sandboxMode": "danger-full-access",
      "timeoutMs": 1200000,
      "maxAutomaticRetries": 1,
      "failFastOnApprovalSensitive": true
    }
  },
  "validationProfiles": [
    {
      "id": "docs-basic",
      "description": "Diff hygiene checks for documentation-only changes.",
      "commands": [
        [
          "git",
          "diff",
          "--check"
        ]
      ],
      "cwdMode": "worktree",
      "required": true,
      "parser": "exit_code",
      "baselineProfile": "none",
      "autonomyClass": "fully_autonomous"
    },
    {
      "id": "docs-app-build",
      "description": "Build the docs app when docs application sources are touched.",
      "commands": [
        [
          "yarn",
          "workspace",
          "open-mercato-docs",
          "build"
        ]
      ],
      "cwdMode": "target_root",
      "required": false,
      "parser": "line_set",
      "baselineProfile": "target_head",
      "autonomyClass": "fully_autonomous"
    },
